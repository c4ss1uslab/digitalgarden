{% if relevancescore
   or relevancecontext
   or alivenessscore
   or familiaritylevel
   or cognitivecomplexity
   or complexitycontext
   or emotionaldensity
   or emotionalcontext
   or informationscope
   or epistemicstatus
   or confidencelevel %}

<div class="note-metadata">

  {% if relevancescore %}
  <div class="metadata-row">
    <span class="metadata-label">Relevance</span>
    <span class="metadata-value metadata-score">{{ relevancescore }}</span>
  </div>
  {% endif %}

  {% if relevancecontext %}
  <div class="metadata-row">
    <span class="metadata-label">Relevance context</span>
    <span class="metadata-value">{{ relevancecontext }}</span>
  </div>
  {% endif %}

  {% if alivenessscore %}
  <div class="metadata-row">
    <span class="metadata-label">Aliveness</span>
    <span class="metadata-value metadata-score">{{ alivenessscore }}</span>
  </div>
  {% endif %}

  {% if familiaritylevel %}
  <div class="metadata-row">
    <span class="metadata-label">Familiarity</span>
    <span class="metadata-value">{{ familiaritylevel }}</span>
  </div>
  {% endif %}

  {% if cognitivecomplexity %}
  <div class="metadata-row">
    <span class="metadata-label">Cognitive complexity</span>
    <span class="metadata-value">{{ cognitivecomplexity }}</span>
  </div>
  {% endif %}

  {% if complexitycontext %}
  <div class="metadata-row">
    <span class="metadata-label">Complexity context</span>
    <span class="metadata-value">{{ complexitycontext }}</span>
  </div>
  {% endif %}

  {% if emotionaldensity %}
  <div class="metadata-row">
    <span class="metadata-label">Emotional density</span>
    <span class="metadata-value">{{ emotionaldensity }}</span>
  </div>
  {% endif %}

  {% if emotionalcontext %}
  <div class="metadata-row">
    <span class="metadata-label">Emotional context</span>
    <span class="metadata-value">{{ emotionalcontext }}</span>
  </div>
  {% endif %}

  {% if informationscope %}
  <div class="metadata-row">
    <span class="metadata-label">Information scope</span>
    <span class="metadata-value">{{ informationscope }}</span>
  </div>
  {% endif %}

  {% if epistemicstatus %}
  <div class="metadata-row">
    <span class="metadata-label">Epistemic status</span>
    <span class="metadata-value">{{ epistemicstatus }}</span>
  </div>
  {% endif %}

  {% if confidencelevel %}
  <div class="metadata-row">
    <span class="metadata-label">Confidence level</span>
    <span class="metadata-value">{{ confidencelevel }}</span>
  </div>
  {% endif %}

</div>

{% endif %}
